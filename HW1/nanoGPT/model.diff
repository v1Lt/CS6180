+class SwiGLUMLP(nn.Module):
+    """ SwiGLU: W2 (SiLU(W1 x) * (W3 x)), with the hidden size chosen so the parameter count matches the GELU MLP. """
+
+    def __init__(self, config):
+        super().__init__()
+        hidden = int(8 * config.n_embd / 3)
+        hidden = 64 * ((hidden + 63) // 64)
+        self.c_fc    = nn.Linear(config.n_embd, 2 * hidden, bias=config.bias) # fused W1 (gate) and W3 (up)
+        self.c_proj  = nn.Linear(hidden, config.n_embd, bias=config.bias)
+        self.dropout = nn.Dropout(config.dropout)
+
+    def forward(self, x):
+        gate, up = self.c_fc(x).chunk(2, dim=-1)
+        x = F.silu(gate) * up
+        x = self.c_proj(x)
+        x = self.dropout(x)
+        return x
